load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//scala:scala.bzl", "scala_doc", "scala_library")
load("//scala:scala_toolchain.bzl", "scala_toolchain")
load(
    ":toolchain_plugins_test.bzl",
    "scala_doc_toolchain_options_test",
    "toolchain_plugin_absent_test",
    "toolchain_plugin_present_test",
)

# These analysis tests never execute the plugin, so any jar works on any
# Scala version, unlike a working compiler plugin -- e.g.
# @rules_scala_test_maven//:org_typelevel_kind_projector_2_12_20, which is
# built for Scala 2 specifically and would need to match the toolchain's
# version.
genrule(
    name = "dummy_plugin",
    outs = ["dummy_plugin.jar"],
    cmd = "touch $@",
)

# A toolchain that enables a compiler plugin for every target.
scala_toolchain(
    name = "with_plugin_impl",
    plugins = [":dummy_plugin"],
    scalacopts = ["-P:dummy:$(location //test/toolchain_plugins:dummy_plugin)"],
    visibility = ["//visibility:public"],
)

toolchain(
    name = "with_plugin",
    toolchain = ":with_plugin_impl",
    toolchain_type = "//scala:toolchain_type",
    visibility = ["//visibility:public"],
)

scala_library(
    name = "plain_library",
    srcs = ["Placeholder.scala"],
)

toolchain_plugin_present_test(
    name = "toolchain_plugin_present_test",
    size = "small",
    target_under_test = ":plain_library",
)

toolchain_plugin_absent_test(
    name = "toolchain_plugin_absent_test",
    size = "small",
    target_under_test = ":plain_library",
)

# Scaladoc fails with `bad option: '-x:s'` if it splits this option.
scala_doc(
    name = "plain_doc",
    scala_version = "2.13.18",
    scalacopts = ["-Wconf:msg=a -x:s"],
    deps = [":plain_library"],
)

scala_doc_toolchain_options_test(
    name = "scala_doc_toolchain_options_test",
    size = "small",
    target_under_test = ":plain_doc",
)

build_test(
    name = "plain_doc_build_test",
    targets = [":plain_doc"],
)
