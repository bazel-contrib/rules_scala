# x2cpg already runs its own full test suite, unfiltered; jssrc2cpg's
# smoke suite doesn't cover it, since jssrc2cpg only calls x2cpg's code
# from its own subclasses.
#
# Wraps the existing FrontendHTTPServerTests (the HTTP server/client base
# every frontend's own HTTP test builds on) as io.joern.smoke.SmokeSuite --
# see BUILD's test_filter comment. ~105s -> ~3s.
--- /dev/null
+++ b/joern-cli/frontends/x2cpg/src/test/scala/io/joern/smoke/SmokeSuite.scala
@@ -0,0 +1,6 @@
+package io.joern.smoke
+
+import io.joern.x2cpg.utils.server.FrontendHTTPServerTests
+import org.scalatest.Suites
+
+class SmokeSuite extends Suites(new FrontendHTTPServerTests)
