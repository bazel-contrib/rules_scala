load("//scala:scala.bzl", "scala_library")
load("//test/expect_build_failure:expect_build_failure.bzl", "expect_build_failure_test", "expect_build_success_test")

# `a` uses a symbol reachable only transitively through
# @org_springframework_spring_tx; only plus-one mode allows that. Tagged "manual"
# so a default-toolchain wildcard build skips it (the nested build below names it
# explicitly and supplies the plus-one toolchain).
scala_library(
    name = "a",
    testonly = True,
    srcs = ["A.scala"],
    tags = ["manual"],
    deps = ["@org_springframework_spring_tx"],
)

expect_build_success_test(
    name = "plus_one_deps_external_deps_test",
    build_args = ["--extra_toolchains=//test_expect_failure/plus_one_deps:plus_one_deps"],
    target = ":a",
)

# Negative control: without the plus-one toolchain, `a`'s use of a transitive
# symbol of @org_springframework_spring_tx is a strict-deps error.
expect_build_failure_test(
    name = "plus_one_deps_external_deps_undefined_fails_test",
    target = ":a",
)
