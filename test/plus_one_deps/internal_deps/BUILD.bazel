load("//scala:scala.bzl", "scala_library")
load("//test/expect_build_failure:expect_build_failure.bzl", "expect_build_failure_test")
load("//test/plus_one_deps:toolchain_transition.bzl", "toolchain_build_test")

# Plus-one dependency mode lets `a` use a symbol from `c` (a dependency of its
# direct dep `b`); under the default toolchain that transitive use is a
# strict-deps error. The libraries are tagged "manual" so a plain wildcard build
# (default toolchain) skips them; the tests below reach them through a label,
# which bypasses "manual", and supply the plus-one toolchain.
scala_library(
    name = "a",
    srcs = ["A.scala"],
    tags = ["manual"],
    deps = [":b"],
)

scala_library(
    name = "b",
    srcs = ["B.scala"],
    tags = ["manual"],
    deps = [":c"],
)

scala_library(
    name = "c",
    srcs = ["C.scala"],
    tags = ["manual"],
)

toolchain_build_test(
    name = "plus_one_deps_internal_deps_test",
    extra_toolchains = ["//test_expect_failure/plus_one_deps:plus_one_deps"],
    target = ":a",
)

# Negative control: without the plus-one toolchain, `a`'s transitive use of `c`
# is a strict-deps error, so the build must fail.
expect_build_failure_test(
    name = "plus_one_deps_internal_deps_undefined_fails_test",
    target = ":a",
)
