)

scala_library(
    name = "all_lib",
    srcs = glob(["*.scala"]),
)

semanticdb_vars_script(
    name = "semantic_provider_vars_all",
    dep = "all_lib",
)

scala_library(
    name = "empty_lib",
    srcs = [],
)

semanticdb_vars_script(
    name = "semantic_provider_vars_empty",
    dep = "empty_lib",
)

scala_library(
    name = "lib_with_tempsrc",
    srcs = glob(
        [
            "*.scala",
            "tempsrc/*.scala",  #Include src files that are dynamically generated by the test_semanticdb.sh (tmpsrc should be in .gitignore so its contents don't get checked in)
        ],
        allow_empty = True,
    ),
)

# The nested `bazel build` here reads the on-disk checkout directly, so its
# inputs must be declared by hand -- same reasoning as the expect_*_test
# macros below. The `.bazelrc`/`.bazelversion`/lockfile/`_SCALAC_JAR` entries
# below match those macros' own list; the fixture_actions targets are their
# per-fixture action fingerprint.
_SCALAC_JAR = "//src/java/io/bazel/rulesscala/scalac:scalac_deploy.jar"

_SEMANTICDB_FIXTURE_DATA = glob([
    "*.scala",
    "BUILD",
    "rules.bzl",
    "semantic_provider_vars.sh.template",
]) + [
    "//:.bazelrc",
    "//:.bazelversion",
    "//:MODULE.bazel",
    "//:MODULE.bazel.lock",
    "//scala:semanticdb_provider.bzl",
    "//scala/private:phases/phase_semanticdb.bzl",
    _SCALAC_JAR,
    "//test/expect_build_failure:nested_bazel.sh",
]

expect_build_success_test(
    name = "empty_semanticdb_test",
    build_args = ["--extra_toolchains=//test/semanticdb:semanticdb_nobundle_toolchain"],
    target = ":semantic_provider_vars_empty",
)

expect_build_success_test(
    name = "semanticdb_synthetics_toolchain_scalaopt_test",
    build_args = ["--extra_toolchains=//test/semanticdb:semanticdb_synthetics_toolchain"],
    target = ":all_lib",
)

fixture_actions(
    name = "all_lib_fixture_actions",
    testonly = True,
    target = ":all_lib",
)

fixture_actions(
    name = "lib_with_tempsrc_fixture_actions",
    testonly = True,
    extra_toolchains = ["//test/semanticdb:semanticdb_nobundle_toolchain"],
    target = ":lib_with_tempsrc",
)

fixture_actions(
    name = "semantic_provider_vars_all_bundle_fixture_actions",
    testonly = True,
    extra_toolchains = ["//test/semanticdb:semanticdb_bundle_toolchain"],
    target = ":semantic_provider_vars_all",
)

fixture_actions(
    name = "semantic_provider_vars_all_nobundle_fixture_actions",
    testonly = True,
    extra_toolchains = ["//test/semanticdb:semanticdb_nobundle_toolchain"],
    target = ":semantic_provider_vars_all",
)

sh_test(
    name = "no_semanticdb_test",
    size = "large",
    srcs = ["no_semanticdb_test.sh"],
    data = _SEMANTICDB_FIXTURE_DATA + [":all_lib_fixture_actions"],
    tags = [
        "exclusive",
        "no-remote-exec",
        "no-sandbox",
        "requires-network",
    ],
)

sh_test(
    name = "removed_sourcefiles_test",
    size = "large",
    srcs = ["removed_sourcefiles_test.sh"],
    data = _SEMANTICDB_FIXTURE_DATA + [":lib_with_tempsrc_fixture_actions"],
    tags = [
        "exclusive",
        "no-remote-exec",
        "no-sandbox",
        "requires-network",
    ],
)

[
    sh_test(
        name = "produces_semanticdb_test_scala%d_%s" % (
            scala_epoch,
            "bundle" if is_bundle else "nobundle",
        ),
        size = "large",
        srcs = ["produces_semanticdb_test.sh"],
        args = [
            "--toolchain=" + ("//test/semanticdb:semanticdb_bundle_toolchain" if is_bundle else "//test/semanticdb:semanticdb_nobundle_toolchain"),
            "--is-bundle=" + str(is_bundle),
            "--scala-epoch=" + str(scala_epoch),
        ] + (["--repo_env=SCALA_VERSION=3.3.8"] if scala_epoch == 3 else []),
        data = _SEMANTICDB_FIXTURE_DATA + (
            [] if scala_epoch == 3 else [":semantic_provider_vars_all_bundle_fixture_actions" if is_bundle else ":semantic_provider_vars_all_nobundle_fixture_actions"]
        ),
        tags = [
            "exclusive",
            "no-remote-exec",
            "no-sandbox",
            "requires-network",
        ] + (
            # fixture_actions analyses the fixture under the outer build's
            # default Scala version, so it can't see a rules change that only
            # affects the Scala 3 codepath this repo_env override selects.
            ["external"] if scala_epoch == 3 else []
        ),
    )
    for is_bundle in (0, 1)
    for scala_epoch in (2, 3)
]

# Scala versions the toolchain_deps semanticdb classpath is resolved against.
_TOOLCHAIN_DEPS_SCALA_VERSIONS = [
    "2.12.21",
    "2.13.18",
    "3.3.8",
    "3.8.4",
]

[
    expect_build_success_test(
        name = "toolchain_deps_semanticdb_builds_scala_" + scala_version.replace(".", "_"),
        build_args = ["--repo_env=SCALA_VERSION=" + scala_version],
        # //scala/private/toolchain_deps is production code, not a fixture in this
        # package, so the macro's automatic glob of this package's sources does not
        # cover it. Depend on the built target directly so a change to its .bzl
        # sources still invalidates this test's cache key.
        data = ["//scala/private/toolchain_deps:semanticdb"],
        no_fingerprint_reason = "this nested build only builds toolchain deps, so it runs no rules_scala action to fingerprint; the data above covers what it does build",
        target = "//scala/private/toolchain_deps:semanticdb",
    )
    for scala_version in _TOOLCHAIN_DEPS_SCALA_VERSIONS
]
