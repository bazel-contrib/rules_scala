"""Standalone root module for the fake-root bzlmod macro test.

This module wraps test_module so the extension under test is unused by the real
root module and must synthesize empty root-module tags.
"""

module(name = "test_root_module", version = "0.0.0")

bazel_dep(name = "rules_scala")
local_path_override(
    module_name = "rules_scala",
    path = "${rules_scala_dir}",
)

bazel_dep(name = "latest_dependencies")
local_path_override(
    module_name = "latest_dependencies",
    path = "${latest_deps_dir}",
)

bazel_dep(name = "test_module")
local_path_override(
    module_name = "test_module",
    path = "${test_module_dir}",
)
